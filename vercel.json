{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://tri-service-profiler-production.up.railway.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tri-service-profiler-production.up.railway.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
